// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id           Int      @id @default(autoincrement())
  interest     String
  pillars      String?
  budget       String?
  user_name    String
  user_company String?
  user_email   String
  user_phone   String?
  user_source  String?
  message      String   @db.Text
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Meeting {
  id          Int      @id @default(autoincrement())
  email       String
  title       String   @default("New Meeting Request")
  date        String
  time        String
  description String   @default("A user has requested to join from the email section.") @db.Text
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id                Int      @id @default(autoincrement())
  title             String
  metaTitle         String?
  metaDescription   String?  @db.Text
  category          String
  image             String
  heroImage         String?
  heroVideo         String?
  video             String?
  path              String   @unique
  description       String   @default("") @db.Text
  sections          String   @default("[]") @db.Text
  position          Int      @default(0)
  client            String?
  service           String?
  duration          String?
  deliverables      String?
  overviewHeading   String?
  overviewText      String?  @db.Text
  challengeHeading  String?
  challengeText     String?  @db.Text
  results           String?  @default("[]") @db.Text
  processSteps      String?  @default("[]") @db.Text
  galleryCategories String?  @default("[]") @db.Text
  videoTabs         String?  @default("[]") @db.Text
  ctaUrl            String?
  ctaText           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Review {
  id          Int      @id @default(autoincrement())
  clientName  String
  company     String?
  projectName String?
  projectLink String?
  video       String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SocialMedia {
  id          Int      @id @default(autoincrement())
  videoUrl    String
  projectName String?
  projectLink String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Media {
  id        Int      @id @default(autoincrement())
  filename  String
  mimeType  String
  folder    String   @default("blogs")
  data      Bytes?   @db.LongBlob
  url       String?  // Direct static file URL e.g. https://api.elipsestudio.com/uploads/media/59.webp
  createdAt DateTime @default(now())
}

model CaseStudy {
  id                Int      @id @default(autoincrement())
  title             String
  metaTitle         String?
  metaDescription   String?  @db.Text
  slug              String   @unique
  largeBanner       String?
  smallBanner       String?
  heroImage         String?
  heroVideo         String?
  content           String   @default("") @db.Text
  client            String?
  service           String?
  category          String?
  duration          String?
  deliverables      String?
  overviewHeading   String?
  overviewText      String?  @db.Text
  challengeHeading  String?
  challengeText     String?  @db.Text
  results           String?  @default("[]") @db.Text
  processSteps      String?  @default("[]") @db.Text
  galleryCategories String?  @default("[]") @db.Text
  videoTabs         String?  @default("[]") @db.Text
  ctaUrl            String?
  ctaText           String?
  videoUrl          String?
  featured          Boolean  @default(false)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Blog {
  id              Int      @id @default(autoincrement())
  title           String
  metaTitle       String?
  metaDescription String?  @db.Text
  slug            String   @unique
  excerpt         String   @db.Text
  content         String   @db.Text
  sections        String   @default("[]") @db.Text
  image           String
  image2          String?
  image3          String?
  image4          String?
  video           String?
  video2          String?
  video3          String?
  category        String
  date            String
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
